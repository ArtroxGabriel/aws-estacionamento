# DynamoDB real (AWS Academy) só para a auditoria. O resto continua local.
# Copie para infra/.env (já ignorado pelo git) e preencha com as credenciais do
# Learner Lab (AWS Details > AWS CLI > Show). Elas expiram: ao reiniciar o lab,
# atualize e rode `task up` de novo.

# Endpoint vazio = DynamoDB da AWS (o padrão do compose é o DynamoDB Local).
DYNAMODB_ENDPOINT_URL=

DYNAMODB_ACCESS_KEY_ID=
DYNAMODB_SECRET_ACCESS_KEY=
DYNAMODB_SESSION_TOKEN=

# Região do lab (o compose usa us-east-1 para API e worker).
