# Credenciais S3 (RustFS) & DynamoDB Local
AWS_DEFAULT_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Armazenamento de Arquivos (RustFS - compatível com S3)
S3_ENDPOINT_URL=http://localhost:9000
S3_BUCKET_NAME=estacionamento-fotos-veiculos-local

# Banco NoSQL de Auditoria (DynamoDB Local ou AWS)
DYNAMODB_ENDPOINT_URL=http://localhost:8000
DYNAMODB_TABLE_NAME=AuditoriaEstacionamento

# Mensageria Assíncrona (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_QUEUE_NAME=ocr-processamento-fila

# Banco Relacional (PostgreSQL)
DATABASE_URL=postgres://app_user:app_password@localhost:5432/estacionamento?sslmode=disable

# Cache em Memória (Redis)
REDIS_URL=localhost:6379
