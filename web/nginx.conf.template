# Conexões reaproveitadas com a API: sem keepalive cada request abre um TCP
# novo, e os TIME_WAIT lotam a tabela conntrack do Docker sob carga.
upstream api_backend {
    server ${API_UPSTREAM_HOST};
    keepalive 64;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Uploads de foto: a API aceita até 10 MB (+ overhead do multipart).
    client_max_body_size 12m;

    # A barra final no proxy_pass remove o prefixo /api.
    location /api/ {
        proxy_pass http://api_backend/;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Rotas do React Router caem no index.html.
    location / {
        try_files $uri /index.html;
    }
}
